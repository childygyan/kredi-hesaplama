---
/** SSS bölümü — akordeon + FAQPage JSON-LD (SEO). */
interface Props {
  sorular: Array<{ soru: string; cevap: string }>;
  baslik?: string;
}

const { sorular, baslik = 'Sık Sorulan Sorular' } = Astro.props;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sorular.map((s) => ({
    '@type': 'Question',
    name: s.soru,
    acceptedAnswer: { '@type': 'Answer', text: s.cevap },
  })),
};
---

<section aria-label={baslik} class="mt-12">
  <h2 class="text-2xl font-bold text-slate-900">{baslik}</h2>
  <div class="mt-4 space-y-3">
    {sorular.map((s) => (
      <details class="rounded-xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-medium text-slate-800">{s.soru}</summary>
        <p class="mt-2 text-slate-600">{s.cevap}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>
