---
/**
 * ErkenOdemeHesaplayici — erken kapatma / erken ödeme hesaplayıcı.
 * Ceza oranı kullanıcıdan alınır (varsayılan %0); yasal üst sınır iddia edilmez.
 * Betik, data-öznitelikleri üzerinden çalışır (define:vars yok).
 */
---

<section
  data-erken-odeme
  aria-label="Erken ödeme hesaplama"
  class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
>
  <h2 class="text-2xl font-bold text-slate-900">Erken Ödeme Hesaplama</h2>
  <p class="mt-2 text-slate-600">
    Kredinizi vadesinden önce kapatırsanız ne kadar faizden kurtulacağınızı hesaplayın.
  </p>

  <form data-eo-form class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" novalidate>
    <div>
      <label for="eoh-tutar" class="block text-sm font-medium text-slate-700">Kredi Tutarı (TL)</label>
      <input id="eoh-tutar" data-eo="tutar" type="text" inputmode="decimal" value="200.000"
        class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <p class="mt-1 text-xs text-slate-400">Örnek değer.</p>
    </div>
    <div>
      <label for="eoh-faiz" class="block text-sm font-medium text-slate-700">Aylık Faiz Oranı (%)</label>
      <input id="eoh-faiz" data-eo="faiz" type="text" inputmode="decimal" placeholder="Örn. 3,5" required
        class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <p class="mt-1 text-xs text-slate-400">Bankanızın verdiği oranı girin.</p>
    </div>
    <div>
      <label for="eoh-vade" class="block text-sm font-medium text-slate-700">Vade (Ay)</label>
      <input id="eoh-vade" data-eo="vade" type="number" min="1" max="600" value="24"
        class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label for="eoh-odenen" class="block text-sm font-medium text-slate-700">Ödenen Taksit Sayısı</label>
      <input id="eoh-odenen" data-eo="odenen" type="number" min="0" max="600" value="12"
        class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100" />
    </div>
    <div>
      <label for="eoh-ceza" class="block text-sm font-medium text-slate-700">Erken Kapatma Cezası (%)</label>
      <input id="eoh-ceza" data-eo="ceza" type="text" inputmode="decimal" value="0"
        class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      <p class="mt-1 text-xs text-slate-400">Banka sözleşmenizde yazar; bilmiyorsanız 0 bırakın.</p>
    </div>
    <div class="flex items-end">
      <label class="flex items-center gap-2 text-sm text-slate-700">
        <input id="eoh-muaf" data-eo="muaf" type="checkbox" class="h-4 w-4 rounded border-slate-300" />
        Konut kredisi (vergiden muaf)
      </label>
    </div>
    <div class="sm:col-span-2 lg:col-span-3">
      <button type="submit"
        class="w-full rounded-lg bg-brand-700 px-6 py-3 font-semibold text-white hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-300 sm:w-auto">
        Hesapla
      </button>
      <p data-eo="hata" role="alert" class="mt-2 hidden text-sm font-medium text-red-600"></p>
    </div>
  </form>

  <div data-eo="sonuc" class="mt-6 hidden" aria-live="polite">
    <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl bg-brand-50 p-4">
        <dt class="text-sm text-slate-600">Kalan Anapara</dt>
        <dd data-eo-sonuc="kalan" class="mt-1 text-2xl font-extrabold text-brand-800">—</dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4">
        <dt class="text-sm text-slate-600">Erken Kapatma Tutarı</dt>
        <dd data-eo-sonuc="kapatma" class="mt-1 text-xl font-bold text-slate-900">—</dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4">
        <dt class="text-sm text-slate-600">Kalan Taksit</dt>
        <dd data-eo-sonuc="kalanTaksit" class="mt-1 text-xl font-bold text-slate-900">—</dd>
      </div>
      <div class="rounded-xl bg-emerald-50 p-4">
        <dt class="text-sm text-slate-600">Faiz Tasarrufu</dt>
        <dd data-eo-sonuc="tasarruf" class="mt-1 text-xl font-bold text-emerald-700">—</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import { erkenOdemeHesapla, tlBicimle, KrediHesaplamaHatasi } from '../lib/kredi.ts';

  function sayiParse(deger: string): number {
    const temiz = deger.trim().replace(/\./g, '').replace(',', '.');
    const sayi = Number(temiz);
    if (temiz === '' || Number.isNaN(sayi)) throw new KrediHesaplamaHatasi('Lütfen geçerli sayılar girin.');
    return sayi;
  }

  document.querySelectorAll<HTMLElement>('[data-erken-odeme]').forEach((kok) => {
    const form = kok.querySelector<HTMLFormElement>('[data-eo-form]');
    const hataEl = kok.querySelector<HTMLElement>('[data-eo="hata"]');
    const sonucEl = kok.querySelector<HTMLElement>('[data-eo="sonuc"]');
    if (!form || !hataEl || !sonucEl) return;

    const girdiAlani = (ad: string): string => {
      const el = kok.querySelector<HTMLInputElement>(`[data-eo="${ad}"]`);
      return el ? el.value : '';
    };
    const sonucYaz = (ad: string, metin: string): void => {
      const el = kok.querySelector<HTMLElement>(`[data-eo-sonuc="${ad}"]`);
      if (el) el.textContent = metin;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      hataEl.classList.add('hidden');
      try {
        const muafEl = kok.querySelector<HTMLInputElement>('[data-eo="muaf"]');
        const s = erkenOdemeHesapla({
          anapara: sayiParse(girdiAlani('tutar')),
          aylikFaizOrani: sayiParse(girdiAlani('faiz')),
          vadeAy: Math.trunc(sayiParse(girdiAlani('vade'))),
          odenenAy: Math.trunc(sayiParse(girdiAlani('odenen'))),
          erkenKapanisCezasiOrani: sayiParse(girdiAlani('ceza')),
          vergidenMuaf: muafEl ? muafEl.checked : false,
        });
        sonucYaz('kalan', tlBicimle(s.kalanAnapara));
        sonucYaz('kapatma', tlBicimle(s.erkenKapatmaTutari));
        sonucYaz('kalanTaksit', String(s.kalanTaksitSayisi));
        sonucYaz('tasarruf', tlBicimle(s.tasarruf));
        sonucEl.classList.remove('hidden');
      } catch (err) {
        const mesaj = err instanceof KrediHesaplamaHatasi ? err.message : 'Hesaplama sırasında bir hata oluştu.';
        hataEl.textContent = mesaj;
        hataEl.classList.remove('hidden');
      }
    });
  });
</script>
