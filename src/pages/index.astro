---
import BaseLayout from '../layouts/BaseLayout.astro';
import KrediHesaplayici from '../components/KrediHesaplayici.astro';
import SssBolumu from '../components/SssBolumu.astro';
import ReklamAlani from '../components/ReklamAlani.astro';
import BankaCta from '../components/BankaCta.astro';

const sorular = [
  {
    soru: 'Kredi hesaplama nasıl yapılır?',
    cevap:
      'Kredi tutarını, bankanın verdiği aylık faiz oranını ve vadeyi girmeniz yeterlidir. ' +
      'Araç, eşit taksit formülüyle aylık taksit tutarınızı, toplam geri ödeme miktarınızı ve ' +
      'faiz ile vergi maliyetinizi hesaplar.',
  },
  {
    soru: 'Aylık taksit tutarı nasıl hesaplanır?',
    cevap:
      'Eşit taksitli kredilerde aylık taksit, anüite formülüyle bulunur: taksit tutarı; ' +
      'kredi tutarına, aylık faiz oranına ve vade sayısına göre belirlenir. Faiz oranı ' +
      'yükseldikçe veya vade uzadıkça toplam geri ödeme artar.',
  },
  {
    soru: 'KKDF ve BSMV nedir?',
    cevap:
      'KKDF (Kaynak Kullanımını Destekleme Fonu) ve BSMV (Banka ve Sigorta Muameleleri ' +
      'Vergisi), ihtiyaç ve taşıt gibi tüketici kredilerinde faiz üzerinden alınan ' +
      'kalemlerdir. Konut kredilerinde bu iki kalem alınmaz. Oranlar değişebildiği için ' +
      'güncel oranları bankanızdan teyit edin.',
  },
  {
    soru: 'Konut kredisi hesaplaması diğerlerinden farklı mı?',
    cevap:
      'Evet. Konut kredileri KKDF ve BSMV’den muaf olduğu için aynı faiz oranında aylık ' +
      'taksit, ihtiyaç veya taşıt kredisine göre daha düşük çıkar. Konut Kredisi Hesaplama ' +
      'sayfamız bu muafiyeti otomatik uygular.',
  },
  {
    soru: 'Kredimi erken kapatırsam ne kadar kâr ederim?',
    cevap:
      'Vadesinden önce kapatılan kredide, ödenmemiş taksitlerin faizi işlemez; bu da ' +
      'faiz tasarrufu sağlar. Banka sözleşmenize göre erken kapatma cezası uygulanabilir. ' +
      'Erken Ödeme Hesaplama sayfamızda kalan borcunuzu ve tasarrufunuzu hesaplayabilirsiniz.',
  },
  {
    soru: 'Bu sitedeki faiz oranları güncel mi?',
    cevap:
      'Hayır. Bu site güncel faiz oranı yayınlamaz; tüm hesaplamalarda oranı siz girersiniz. ' +
      'En doğru sonuç için bankanızın size özel verdiği aylık faiz oranını kullanın.',
  },
];
---

<BaseLayout
  title="Kredi Hesaplama | Aylık Taksit ve Toplam Geri Ödeme Hesaplama"
  description="Kredi hesaplama aracıyla ihtiyaç, konut ve taşıt kredilerinizin aylık taksit tutarını, toplam geri ödeme miktarını ve faiz maliyetini saniyeler içinde hesaplayın. Ücretsiz."
  path="/"
>
  <section class="text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
      Kredi Hesaplama
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
      İhtiyaç, konut ve taşıt kredilerinizin aylık taksitini, toplam geri ödemesini ve
      faiz maliyetini saniyeler içinde hesaplayın. Ücretsiz, hızlı ve kolay.
    </p>
  </section>

  <div class="mt-8">
    <KrediHesaplayici
      krediTuru="ihtiyac"
      baslik="Kredi Hesaplama Aracı"
      aciklama="Tutar, faiz oranı ve vadeyi girin; aylık taksitinizi ve ödeme planınızı görün."
    />
  </div>

  <ReklamAlani />

  <section class="mt-12" aria-label="Kredi türüne göre hesaplama">
    <h2 class="text-2xl font-bold text-slate-900">Kredi Türüne Göre Hesaplama</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href="/ihtiyac-kredisi-hesaplama/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">İhtiyaç Kredisi Hesaplama</h3>
        <p class="mt-1 text-sm text-slate-600">
          Bireysel ihtiyaç kredilerinde aylık taksit ve toplam maliyet hesabı.
        </p>
      </a>
      <a
        href="/konut-kredisi-hesaplama/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">Konut Kredisi Hesaplama</h3>
        <p class="mt-1 text-sm text-slate-600">
          Vergi muafiyetli konut kredisi taksit ve ödeme planı hesabı.
        </p>
      </a>
      <a
        href="/tasit-kredisi-hesaplama/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">Taşıt Kredisi Hesaplama</h3>
        <p class="mt-1 text-sm text-slate-600">
          Araç kredilerinde aylık taksit ve toplam geri ödeme hesabı.
        </p>
      </a>
      <a
        href="/erken-odeme-hesaplama/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">Erken Ödeme Hesaplama</h3>
        <p class="mt-1 text-sm text-slate-600">
          Kredinizi erken kapatırsanız ne kadar faizden kurtulursunuz?
        </p>
      </a>
      <a
        href="/yuzde-hesaplama/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">Yüzde Hesaplama</h3>
        <p class="mt-1 text-sm text-slate-600">
          Yüzde, oran ve yüzde değişim hesapları.
        </p>
      </a>
      <a
        href="/yas-hesaplama/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">Yaş Hesaplama</h3>
        <p class="mt-1 text-sm text-slate-600">
          Doğum tarihinizden tam yaşınızı yıl, ay ve gün olarak bulun.
        </p>
      </a>
    </div>
  </section>

  <section class="mt-12" aria-label="Kredi rehberleri">
    <h2 class="text-2xl font-bold text-slate-900">Kredi Rehberleri</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <a
        href="/rehber/kredi-maliyeti-nasil-hesaplanir/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">Kredi Maliyeti Nasıl Hesaplanır?</h3>
        <p class="mt-1 text-sm text-slate-600">
          Nominal faiz, efektif maliyet ve vadenin toplam geri ödemeye etkisi.
        </p>
      </a>
      <a
        href="/rehber/kkdf-bsmv-nedir/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">KKDF ve BSMV Nedir?</h3>
        <p class="mt-1 text-sm text-slate-600">
          Kredi vergileri, hangi kredilerde alınır, konut neden muaf?
        </p>
      </a>
      <a
        href="/rehber/erken-odeme-kurallari/"
        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow"
      >
        <h3 class="font-bold text-brand-800">Kredide Erken Ödeme Kuralları</h3>
        <p class="mt-1 text-sm text-slate-600">
          Erken kapatma cezası, faiz tasarrufu ve kontrol listesi.
        </p>
      </a>
    </div>
  </section>

  <section class="mt-12" aria-label="Kredi hesaplama nasıl yapılır">
    <h2 class="text-2xl font-bold text-slate-900">Kredi Hesaplama Nasıl Yapılır?</h2>
    <div class="prose mt-4 max-w-none text-slate-600">
      <p>
        Eşit taksitli kredilerde her ay aynı tutar ödenir; taksitin içindeki anapara ve
        faiz payı ise aydan aya değişir. İlk aylarda taksitin büyük kısmı faizden oluşur,
        vade ilerledikçe anapara payı artar. Aylık taksit tutarı; kredi tutarına, aylık
        faiz oranına ve vade sayısına göre anüite formülüyle belirlenir.
      </p>
      <p>
        Toplam maliyeti faiz oranı tek başına belirlemez: vade uzadıkça aylık taksit
        düşer ama toplam geri ödeme artar. İhtiyaç ve taşıt kredilerinde faizin üzerine
        KKDF ve BSMV eklendiği için efektif maliyet, nominal faiz oranından yüksektir.
        Konut kredilerinde bu vergiler alınmaz.
      </p>
      <p>
        Kredi hesaplama yaparken bankanın size özel verdiği <strong>aylık</strong> faiz
        oranını girmeniz önemlidir; ilan edilen oranlarla size uygulanan oran farklı
        olabilir. Bu site güncel oran yayınlamaz — oranı bankanızdan öğrenip araca
        girersiniz.
      </p>
    </div>
  </section>

  <BankaCta baslik="Size Uygun Kredi Tekliflerini Karşılaştırın" />

  <SssBolumu sorular={sorular} />
</BaseLayout>
